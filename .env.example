# Neon (ver adrs/0021-base-de-datos-neon.md)
# Cadena de conexión del branch de desarrollo — Neon Console > Connection Details.
DATABASE_URL=

# Clerk (ver adrs/0022-autenticacion-y-sesion-clerk.md)
# Clerk Dashboard > API Keys, de la aplicación creada para este proyecto.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Dashboard > Webhooks > Signing Secret, del endpoint user.created de este proyecto.
CLERK_WEBHOOK_SECRET=

# Rutas de Clerk (no son secretas, pero clerk init las escribe en .env.local)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/iniciar-sesion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
