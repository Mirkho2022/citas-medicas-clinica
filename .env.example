# Neon (ver docs/adrs/0021-base-de-datos-neon.md)
# Cadena de conexión del branch de desarrollo — Neon Console > Connection Details.
DATABASE_URL=

# Tráfico de usuario con RLS (ADR-0023, docs/spike-rls-h2.md): URL DIRECTA (no pooled) del rol `authenticator` del branch.
# Neon Console > Connection Details > rol authenticator. La JWKS de Clerk debe estar registrada para ESE branch:
# POST /projects/{id}/jwks con branch_id (ver docs/spike-rls-h2.md). Secreto del servidor; nunca NEXT_PUBLIC_.
DATABASE_AUTHENTICATED_URL=

# Webhook de Clerk -> perfiles: URL directa del rol `sync_identidad` (LOGIN y contraseña fijados por entorno).
DATABASE_SYNC_URL=

# Clerk (ver docs/adrs/0022-autenticacion-y-sesion-clerk.md)
# Clerk Dashboard > API Keys, de la aplicación creada para este proyecto.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Dashboard > Webhooks > Signing Secret, del endpoint user.created de este proyecto.
CLERK_WEBHOOK_SIGNING_SECRET=

# Rutas de Clerk (no son secretas, pero clerk init las escribe en .env.local)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/iniciar-sesion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Cuentas de prueba de H1 (instancia de desarrollo de Clerk). Ver docs/verificacion-h1.md.
# Correos con +clerk_test: sin correo real, código de verificación 424242.
E2E_ADMINISTRATIVO_EMAIL=
E2E_ADMINISTRATIVO_PASSWORD=
E2E_MEDICO_EMAIL=
E2E_MEDICO_PASSWORD=
E2E_ENFERMERA_EMAIL=
E2E_ENFERMERA_PASSWORD=
E2E_PACIENTE_EMAIL=
E2E_PACIENTE_PASSWORD=
E2E_ADMINISTRATIVO_TOTP_SECRET=

# Pruebas E2E (Playwright, ver docs/pruebas-e2e.md)
# Opcional en local (por defecto levanta `next dev` en localhost:3000). En CI apunta al preview.
PLAYWRIGHT_BASE_URL=
# Vercel > Settings > Deployment Protection > Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=
